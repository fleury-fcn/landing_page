# Copier en .env.deploy (non versionné). Le mot de passe n'est JAMAIS ici :
# il vient du secret Codespaces OVH_SFTP_PASSWORD.
OVH_SFTP_HOST=ftp.clusterXXX.hosting.ovh.net
OVH_SFTP_USER=identifiant-ftp
# Dossier racine associé au domaine dans OVH Manager > Hébergements > Multisite
OVH_REMOTE_DIR=www
