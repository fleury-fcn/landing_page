# Apache (OVHcloud hébergement mutualisé) : copié tel quel dans out/ par `next build`.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

# Images Open Graph générées sans extension (/fr/opengraph-image…)
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>
AddType image/svg+xml .svg
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── HTTPS ───────────────────────────────────────────────────────────────
  # À décommenter UNIQUEMENT quand le certificat SSL est actif pour le domaine
  # (sinon boucle ou erreur de certificat). Derrière le répartiteur OVH,
  # %{HTTPS} n'est pas fiable : on teste le port, comme le recommande OVH.
  # RewriteCond %{SERVER_PORT} 80
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ── Domaine canonique (optionnel) ─────────────────────────────────────────
  # Exemple : rediriger exemple.com vers www.exemple.com
  # RewriteCond %{HTTP_HOST} ^exemple\.com$ [NC]
  # RewriteRule ^ https://www.exemple.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # HSTS : à activer seulement après avoir vérifié HTTPS sur tous les sous-domaines servis.
  # Header always set Strict-Transport-Security "max-age=31536000"

  # Fichiers versionnés par Next.js (hash dans le nom) : cache long
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML et payloads RSC : toujours revalider pour voir les mises à jour tout de suite
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# Ne jamais servir de fichiers cachés ou sensibles s'ils étaient envoyés par erreur
<FilesMatch "^\.(?!htaccess$)|\.(env|log|map|md|sh|bak)$">
  Require all denied
</FilesMatch>
