# Copier en .env.production (non versionné) et remplacer par les URL réelles.
# Ces valeurs sont PUBLIQUES (intégrées au HTML/JS) : n'y mettez aucun secret.
# Le déploiement refuse toute valeur contenant localhost.

# URL publique de la landing (canonical, sitemap, Open Graph), sans slash final
NEXT_PUBLIC_SITE_URL=https://www.example.com
# API Django (hébergée ailleurs : OVH hosting-perso n'exécute pas Python).
# Si elle n'existe pas encore, indiquez son URL future : la page affiche alors
# les chiffres de repli et un message d'indisponibilité pour la recherche.
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_FOOD_URL=https://food.example.com
NEXT_PUBLIC_BEAUTY_URL=https://beauty.example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/votre-org
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
